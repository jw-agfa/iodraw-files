  <diagram name="Move studies to another conference session" id="move-to-conference">
    <mxGraphModel dx="1235" dy="624" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Move studies to another conference session" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="250" width="340" height="26" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Select study(ies) in the conference list, click &quot;Move to conference&quot; (banner or RMC &quot;Conference&quot; menu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="330" y="63" width="340" height="42" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&quot;Move to conference&quot; dialog: pick the target conference session, add a comment, click &quot;Move&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="330" y="143" width="340" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Is the target conference session locked?&amp;nbsp;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="360" y="213" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5b" value="Remaining count &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="790" y="233" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="err5a" value="Error: &quot;Target session just got locked&quot; error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="700" y="323" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="err5b" value="Error: &quot;Target session locked, no task slots left&quot; error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="880" y="323" width="150" height="46" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Current user is presenter/administrator of the SOURCE session?&amp;nbsp;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="360" y="387" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="err1" value="Error: &quot;No permission to move to other session&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="760" y="403" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Current user has &quot;add to conference&quot; permission on the TARGET conference?&amp;nbsp;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="360" y="497" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="err2" value="Error: &quot;No permission to add to conference&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="760" y="513" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Selected studies still belong to the source session (no concurrent change by another user)?&amp;nbsp;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="360" y="607" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="err3" value="Error: &quot;Session list changed&quot; - query list is refreshed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="760" y="623" width="260" height="46" as="geometry" />
        </mxCell>
        <mxCell id="pclass" value="getSrc2TgtTasksMap: for each selected source task, look up non-cancelled discussion task(s) for the same requested procedure (study) already on the target session. Split into srcNeedToMoveTasks (none found) and srcNeedToCombineTasks (found)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="280" y="713" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="remainCnt &amp;gt; 0 AND remainCnt &amp;lt; srcNeedToMoveTasks.size()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="330" y="806" width="340" height="88" as="geometry" />
        </mxCell>
        <mxCell id="err6" value="Error: &quot;N tasks left, but trying to add more than N&amp;nbsp; new tasks&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="780" y="827" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="labelMove" value="&quot;To move&quot; set - moveDiscussionTasks (study not yet discussed in the target session)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="939" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="labelCombine" value="&quot;To combine&quot; set - combineDiscussionTasks (study already has a task in the target)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="939" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="dmove" value="Is source task (A) completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="150" y="969" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pSurvivor" value="Pick survivor: prefer the first in-progress target task for the same study (else the first, if all completed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="969" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pCleanup" value="cleanupStaleDuplicateTargets:&amp;nbsp; For every other completed sibling: reassign its snapshot onto the survivor and unlink it (logs a warning). If an additional in-progress sibling is found (business-invariant violation), only a warning is logged - it is left untouched and simply ignored by the merge below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="1019" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&amp;nbsp;in-progress: reassignTasks moves the task directly into the target session - no new task created, its snapshot follows automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="20" y="1083" width="220" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="completed: createMultiDiscussionWorkflow creates a new discussion task in the target session; the old task&#39;s snapshot is reassigned onto the new task; the old task is unlinked from any session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="260" y="1083" width="240" height="86" as="geometry" />
        </mxCell>
        <mxCell id="dcombine1" value="Is the surviving target task (B) completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="660" y="1147" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="moveFinish" value="For every resulting task : insert the conference comment; recompute status (NONE/PREPARED) from its snapshot count; set its conference-session link to the target session with that status.&amp;nbsp;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="20" y="1261" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2as4a" value="target task B still in-progress: unlink source task A from its session; reassign snapshot A onto task B. Task B survives, now holding snapshot A (+ its own snapshot if any)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="540" y="1251" width="230" height="94" as="geometry" />
        </mxCell>
        <mxCell id="dcombine2" value="Is source task (A) also completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="800" y="1243" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="B completed, A in-progress: reassignTasks moves task A into the target session; snapshot B is reassigned onto task A; task B is unlinked. Task A survives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="800" y="1341" width="230" height="98" as="geometry" />
        </mxCell>
        <mxCell id="s4b" value="both A and B completed: unlink tasks A and B; createMultiDiscussionWorkflow creates a new task C in the target session; both snapshots are reassigned onto task C. Task C survives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="1060" y="1341" width="230" height="98" as="geometry" />
        </mxCell>
        <mxCell id="combineFinish" value="Insert the conference comment on the surviving task. After every &quot;to combine&quot; task is processed, batch-recompute status (NONE/PREPARED) for all surviving tasks from their snapshot counts (updateConferenceStatuses)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
